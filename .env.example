# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# ---- Local LLM (Ollama) ----
CK_MODEL=qwen3:8b
CK_OLLAMA_URL=http://localhost:11434
# 8k context keeps qwen3:8b fully on an 8 GB GPU
CK_NUM_CTX=8192
CK_SEED=42
# Let the model reason (qwen3 "thinking") before choosing the next action
CK_THINK_DECIDE=true

# ---- Storage (defaults shown) ----
# CK_DB=data/commitkeeper.db
# CK_LOG_DIR=logs
# CK_EXPORT_DIR=exports
# CK_FIXTURES=data/fixtures

# ---- Controlled action: follow-up nudges ----
# Only these addresses can ever be nudged (emails cannot change this list)
CK_ALLOWLIST=bilal@example.com,hina@example.com,imran.qadir@uni.example.edu,zainab@example.org
# dry_run = write UNSENT drafts to exports/outbox ; smtp = really send
CK_SEND_MODE=dry_run
# Deliver every nudge to your own test inbox instead of the (fictional) contact
CK_ROUTE_TO=

# ---- Owned test Gmail account (only needed for --source imap / CK_SEND_MODE=smtp) ----
# Gmail needs 2-Step Verification + an App Password (Google Account > Security > App passwords)
CK_IMAP_HOST=imap.gmail.com
CK_IMAP_USER=
CK_IMAP_PASSWORD=
CK_IMAP_FOLDERS=INBOX
CK_SMTP_HOST=smtp.gmail.com
CK_SMTP_PORT=465
CK_SMTP_SSL=true
CK_SMTP_USER=
CK_SMTP_PASSWORD=
CK_SMTP_FROM=

# ---- Testing hooks (leave empty) ----
# fetch | smtp_once | llm_after:N
CK_SIMULATE_FAILURE=
